{
  "snyk.advanced.autoSelectOrganization": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "cSpell.language": "en,pt-BR,pt",
  "cSpell.words": [
    "actionlint",
    "anyio",
    "autoflush",
    "buildx",
    "cap_drop",
    "conftest",
    "cosign",
    "datetime",
    "dependabot",
    "distroless",
    "dockerignore",
    "gitleaks",
    "hadolint",
    "httpx",
    "lifespan",
    "mapped_column",
    "monkeypatch",
    "no-new-privileges",
    "nonroot",
    "opencontainers",
    "pydantic",
    "pyflakes",
    "pyproject",
    "pyright",
    "pytest",
    "readiness",
    "ruff",
    "schemastore",
    "sessionmaker",
    "shellcheck",
    "sonarlint",
    "sqlmodel",
    "starlette",
    "tmpfs",
    "trivy",
    "uvicorn",
    "wolfi"
  ]
}