# Copie para .env e ajuste. O .env está no .gitignore — NUNCA commite o arquivo real.
#
# --- Local (docker-compose.yml): tudo é opcional, há defaults de desenvolvimento.
# --- Produção (docker-compose.prod.yml): IMAGE e POSTGRES_* são OBRIGATÓRIAS.

# Imagem publicada pelo CI no GHCR (sempre em minúsculas).
IMAGE=ghcr.io/gabriel-v-mendes/containeriza-opipelinecicd
IMAGE_TAG=latest

API_PORT=8000

POSTGRES_USER=devops
POSTGRES_DB=devops
# Gere uma senha forte, ex.: openssl rand -base64 32
POSTGRES_PASSWORD=troque-esta-senha
